# ── Required ──────────────────────────────────────────────────────────────────
# Local Docker: postgresql://malalabar:malalabar@localhost:5433/malalabar
# Supabase: the SESSION POOLER string (Connect -> Session pooler, port 5432),
# not the direct db.<ref>.supabase.co host — that one is IPv6-only. The pooler
# is IPv4 and serves both the app and `prisma migrate deploy`. Append
# ?connection_limit=5 (docs/Deployment.md §1).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/malalabar"
# Local Docker: redis://localhost:6379. Upstash: rediss://default:<pw>@<endpoint>.upstash.io:6379
# (rediss = TLS; Upstash refuses plain connections).
REDIS_URL="redis://HOST:6379"
JWT_SECRET="<random 32+ bytes hex>"
JWT_REFRESH_SECRET="<random 32+ bytes hex>"

# ── Optional (shown with defaults) ────────────────────────────────────────────
NODE_ENV="development"
# Render injects PORT (default 10000); do not set it there.
PORT="4000"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
KDS_TOKEN_TTL="90d"
SESSION_TIMEOUT_DEFAULT_MINS="90"
RECONCILE_PENDING_AFTER_MINS="15"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
# Origin baked into every QR code. Must be the real public customer origin in production.
CUSTOMER_APP_URL="http://localhost:3000"
KDS_APP_URL="http://localhost:3002"
# Proxies in front of the API whose X-Forwarded-For entries are trusted.
# 0 locally (no proxy). Required in production — see docs/Deployment.md.
TRUST_PROXY_HOPS="0"
# Header the edge proxy overwrites with the client IP. "cf-connecting-ip" on
# Render (Cloudflare); unset locally. Only that value is accepted.
CLIENT_IP_HEADER=""

# ── External services (required in production) ────────────────────────────────
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
CLOUDINARY_URL=""

# ── AI Insight (optional) ─────────────────────────────────────────────────────
# Anthropic API key; empty disables AI Insight. Server-only — never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=""
# Model ID from https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL="claude-haiku-5-5"

# ── Demo Mode (docs/Demo_Mode.md) — leave unset outside a public demo ─────────
# DEMO_MODE="true" refuses to start unless Midtrans is sandbox
# (MIDTRANS_IS_PRODUCTION=false). A key without "SB-Mid-server-" only warns —
# some sandbox accounts issue keys without it; docs/Deployment.md shows how to
# check a key against the sandbox API.
DEMO_MODE="false"
# Exactly two emails, in order: <cashier>,<admin>. Keep it set after the demo
# ends — listed accounts are locked out whenever DEMO_MODE is not "true".
DEMO_STAFF_EMAILS=""
# Only the demo:seed / demo:reset scripts read this. Never commit a real value.
DEMO_STAFF_PASSWORD=""
DEMO_AI_DAILY_LIMIT="20"
