# Local Docker: postgresql://malalabar:malalabar@localhost:5433/malalabar
# Supabase: the SESSION POOLER string (Connect -> Session pooler, port 5432),
# not the direct db.<ref>.supabase.co host — that one is IPv6-only. The pooler
# is IPv4 and serves both the app and `prisma migrate deploy`. Append
# ?connection_limit=5 (docs/Deployment.md §1).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/malalabar"

# Seed credentials (dev only — change before any real deployment)
SEED_SUPERADMIN_EMAIL="superadmin@malalabar.id"
SEED_SUPERADMIN_PASSWORD="admin123"
