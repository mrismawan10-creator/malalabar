# On Supabase, use the SESSION POOLER string (Connect -> Session pooler), not
# the direct db.<ref>.supabase.co host: that one resolves to IPv6 only, so it
# is unreachable from any network or platform without IPv6 routing. The pooler
# has an IPv4 address and still supports Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/malalabar"

# Seed credentials (dev only — change before any real deployment)
SEED_SUPERADMIN_EMAIL="superadmin@malalabar.id"
SEED_SUPERADMIN_PASSWORD="admin123"
